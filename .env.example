# Clerk — get from dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Supabase — get from supabase.com > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server/webhook only — never expose to browser

# Lemon Squeezy — get from app.lemonsqueezy.com
LEMON_SQUEEZY_WEBHOOK_SECRET=your-webhook-signing-secret
VITE_LEMON_SQUEEZY_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/your-product-id

# Add all of the above to Vercel > Project > Settings > Environment Variables
